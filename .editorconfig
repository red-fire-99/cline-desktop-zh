root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.{md,yml,yaml}]
trim_trailing_whitespace = false

[*.{ps1,psm1}]
charset = utf-8-bom

[*.vbs]
charset = ascii
end_of_line = crlf

[*.cmd]
end_of_line = crlf

[*.json]
indent_size = 2
